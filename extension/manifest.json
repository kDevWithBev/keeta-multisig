{
  "manifest_version": 3,
  "name": "Keeta multisig signer",
  "version": "0.2.0",
  "description": "One Chrome profile, one Keeta signer. A 2-of-3 spend needs a second profile. Not audited.",
  "action": {
    "default_title": "Keeta multisig signer",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://*.keeta.com/*",
    "wss://*.keeta.com/*",
    "https://faucet.test.keeta.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
